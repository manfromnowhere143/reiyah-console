{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reiyah.invalid/research/reference-study/0.1.0/review.schema.json",
  "title": "Reference study 0.1.0 independent review",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_id", "version", "case_id", "protocol_sha256", "reviewer_id", "reviewed_at_utc", "outcome", "validity", "evidence", "reason", "timing_assessment", "visibility_assessment"],
  "properties": {
    "artifact_id": {"const": "reiyah.reference-study.review.0.1.0"},
    "version": {"const": "0.1.0"},
    "case_id": {"type": "string", "pattern": "^[a-f0-9]{24}$"},
    "protocol_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "reviewer_id": {"type": "string", "minLength": 1},
    "reviewed_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"},
    "outcome": {"enum": ["supported", "inconsistent", "unresolved", "not_reviewed"]},
    "validity": {"enum": ["usable", "missing", "sensor_invalid", "out_of_distribution", "abstained"]},
    "evidence": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["evidence_id", "asset_sha256"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "asset_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "reason": {"type": "string", "minLength": 1},
    "timing_assessment": {"type": "string", "minLength": 1},
    "visibility_assessment": {"type": "string", "minLength": 1}
  }
}
